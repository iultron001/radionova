# =============================================================================
# RadiNova AI — Environment Configuration Template
# Copy this file to .env and populate with your credentials. NEVER commit .env!
# =============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
DEBUG=True

# Kaggle API Credentials (Required for dataset downloads in Phase 1 & 4)
# Get yours from https://www.kaggle.com/settings -> "Create New Token" (kaggle.json)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# LLM API Keys (For plain-language Blood/MRI/ECG/CT scan explanations & Chat Assistant)
# RadiNova AI gracefully falls back to template explanations if keys are omitted.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Weights Paths
CHEST_MODEL_PATH=model/weights/chest_densenet121.pth
LIMB_MODEL_PATH=model/weights/limb_densenet121.pth
DEVICE=auto  # Options: auto, cuda, cpu
